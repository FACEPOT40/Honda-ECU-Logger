# Copy this file to keystore.properties (same folder) and fill in your own values.
# keystore.properties is in .gitignore: never commit it, never share it.
# Back up the .jks file and remember the password: every future update must be signed with them.
# Use forward slashes in the path.
storeFile=C:/Users/YOUR_NAME/Documents/H-ECU-keys/h-ecu-release.jks
storePassword=YOUR_PASSWORD
keyAlias=h-ecu
